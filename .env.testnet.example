# Copy to .env.testnet (npm run testnet does this for you). .env* files are gitignored.
# No API keys are required by default.
BITCOIN_NETWORK=testnet

# Esplora REST API for balances, coins, fee estimates, history and broadcasting.
# Testnet4 on mempool.space by default. Blockstream's testnet3 is https://blockstream.info/testnet/api
ESPLORA_API_URL=https://mempool.space/testnet4/api
EXPLORER_URL=https://mempool.space/testnet4

# Optional API key, for Esplora providers that require one (the defaults don't).
# Replace the placeholder with your key; values starting with YOUR_ are ignored.
# Set the header name your provider expects, for example x-api-key or Authorization
# (with a value like "Bearer <token>"). Anything in this file is compiled into the
# app, so use a key restricted to this app, never a secret that must stay private.
ESPLORA_API_KEY=YOUR_ESPLORA_API_KEY
ESPLORA_API_KEY_HEADER=x-api-key

# Fee rate target in blocks (about 10 minutes each). 6 ≈ one hour.
FEE_TARGET_BLOCKS=6
# Client-side limit per transfer, in USD.
MAX_TRANSFER_USD=3000

# Link shown on the landing screen. Leave empty to hide it.
STORE_URL=https://www.physikey.xyz/

# 8 hex characters. Write-protects cards so they can't be overwritten by accident.
# Not a secret: it's compiled into the app. Changing it doesn't affect any wallet.
NTAG_WRITE_PASSWORD=1234abcd
