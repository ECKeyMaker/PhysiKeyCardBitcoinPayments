# Android release signing. Copy this file to android/keystore.properties (gitignored) and
# replace the YOUR_... placeholders. Values starting with YOUR_ are ignored, so until you do,
# release builds are signed with the public debug key (installable, but not for Google Play).
#
# Each value can instead be set as an environment variable with the same name (useful in CI),
# which takes priority over this file. Never put these in .env: it's compiled into the app.
#
# Create an upload key with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore ~/keys/bitwand-upload.keystore \
#     -alias bitwand-upload -keyalg RSA -keysize 2048 -validity 10000
# Keep the keystore outside this repository and back it up with its passwords.

BITWAND_UPLOAD_STORE_FILE=YOUR_PATH_TO_UPLOAD_KEYSTORE
BITWAND_UPLOAD_KEY_ALIAS=YOUR_KEY_ALIAS
BITWAND_UPLOAD_STORE_PASSWORD=YOUR_KEYSTORE_PASSWORD
BITWAND_UPLOAD_KEY_PASSWORD=YOUR_KEY_PASSWORD
